# Copy to .env (never commit it). Defaults shown; dev works with none of these set.
NODE_ENV=development
PORT=3000

# memory = everything in-process | infra = Postgres + Redis + Kafka
STORE_DRIVER=memory
# mock = straight-line demo routes | valhalla
ROUTING_DRIVER=mock
# memory = 5 sample places | photon | pelias
GEOCODER_DRIVER=memory

DATABASE_URL=postgres://wayline:wayline@localhost:5432/wayline
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
VALHALLA_URL=http://localhost:8002
GEOCODER_URL=https://photon.komoot.io

# Required in production (≥ 32 / ≥ 16 chars)
JWT_SECRET=
PHONE_PEPPER=
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000

# Echo OTP codes in the API response (dev only — refused in production)
OTP_DEV_ECHO=true
CORS_ORIGINS=

# SMS: log (dev) | twilio (required in production)
SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# Optional fixed sign-in for App Store / Play review — this number accepts this 6-digit code, no SMS
REVIEW_PHONE=
REVIEW_CODE=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_FORMAT=
METRICS_ENABLED=true
