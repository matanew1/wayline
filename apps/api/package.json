{
  "name": "@wayline/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest --selectProjects unit e2e",
    "test:integration": "jest --selectProjects integration --runInBand",
    "migrate": "node dist/scripts/migrate.js",
    "openapi": "ts-node -P tsconfig.json src/scripts/export-openapi.ts ../../openapi.yaml"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/websockets": "11.1.6",
    "@opentelemetry/auto-instrumentations-node": "0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@socket.io/redis-adapter": "8.3.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "ioredis": "5.7.0",
    "js-yaml": "4.1.0",
    "kafkajs": "2.2.4",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  }
}
