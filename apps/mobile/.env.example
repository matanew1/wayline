# Wayline API. Defaults: http://localhost:3000 (iOS simulator) / http://10.0.2.2:3000 (Android emulator).
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=
# Any MapLibre style URL. Default: the API's /map/style.json (our own tiles when MAP_TILES_URL is set
# on the API, otherwise a redirect to OpenFreeMap "liberty").
EXPO_PUBLIC_MAP_STYLE_URL=
