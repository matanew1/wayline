{
  "name": "wayline",
  "private": true,
  "description": "Wayline — community-powered navigation (backend monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @wayline/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @wayline/api",
    "test:integration": "npm run test:integration -w @wayline/api",
    "dev": "npm run start:dev -w @wayline/api",
    "migrate": "npm run migrate -w @wayline/api",
    "openapi": "npm run openapi -w @wayline/api && npm run generate -w @wayline/contracts",
    "infra:up": "docker compose up -d postgres redis redpanda",
    "infra:down": "docker compose down"
  }
}
