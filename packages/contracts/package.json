{
  "name": "@wayline/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Typed API contract + client for Wayline apps, generated from openapi.yaml",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ../../openapi.yaml -o src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.14.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.2"
  },
  "react-native": "src/index.ts"
}
