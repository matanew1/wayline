{
  "name": "@wayline/navigation-core",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-free turn-by-turn guidance: route tracking, voice timing, report alerts, probe batching, drive simulation",
  "main": "dist/index.js",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "jest": "29.7.0",
    "ts-jest": "29.4.1",
    "typescript": "5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/src/**/*.spec.ts"]
  }
}
